#include <windows.h>

/* Generated by CMake (configure_file); APP_ICON and APP_VERSION come from
   CMakeLists.txt so the resources and the build stay in step. */

1 ICON "@APP_ICON@"

/* RT_MANIFEST (24) + CREATEPROCESS_MANIFEST_RESOURCE_ID (1):
   supportedOS / asInvoker / DPI awareness, so the exe carries a proper
   application manifest like the other projects. */
1 24 "@APP_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APP_VERSION_COMMA@
 PRODUCTVERSION @APP_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "divB"
            VALUE "FileDescription", "MDReader"
            VALUE "FileVersion", "@APP_VERSION@"
            VALUE "InternalName", "MDReader"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "MDReader.exe"
            VALUE "ProductName", "MDReader"
            VALUE "ProductVersion", "@APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
