# ============================================================================
#  .editorconfig - same line endings / indentation everywhere
#
#  Note: .bat must be CRLF + ASCII. cmd.exe mis-parses `^` continuations with
#  plain LF, and Chinese text garbles in a GBK console.
# ============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{ts,tsx,css,html,json,yml,yaml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
